// Orbit: circle the origin at a fixed radius.
//
// The component drives whichever entity carries it. A camera is not an entity
// yet, so game1 and game2 attach this to the mesh and the model orbits.

use std
use engine

@derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)
Orbit := struct {
  radius: float,
  height: float,
  speed:  float,   // radians per second
  angle:  float,   // accumulated, so the system needs no engine clock
}

orbit_system := (t::Transform, orbit::Orbit, dt: float) -> _ {
  orbit.angle := orbit.angle + orbit.speed * dt
  t.translation[0] := cos(orbit.angle) * orbit.radius
  t.translation[1] := orbit.height
  t.translation[2] := sin(orbit.angle) * orbit.radius
}
