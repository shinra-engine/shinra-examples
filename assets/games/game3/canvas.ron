// The screen. The game picture is one node; the HUD is a sibling of it, not
// something layered on afterwards.
(
    name: "dino-run",
    nodes: [
        ( name: "viewport",
          rect: ( fill: true ),
          sprite: Some(( source: View("game") )) ),

        ( name: "crashes",
          rect: ( anchor: TopLeft, size: Some((24, 1)), offset: (1, 0) ),
          text: Some(( from: Some("Run.crashes"), format: "crashes: {}" )) ),

        ( name: "last",
          rect: ( anchor: TopLeft, size: Some((24, 1)), offset: (1, 1) ),
          text: Some(( from: Some("Run.last"), format: "last: {}" )) ),
    ],
)
