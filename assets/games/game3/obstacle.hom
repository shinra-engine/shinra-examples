// Hitting an obstacle restarts the run, and records which one.
//
// The hitbox is the entity's Collider, never its sprite, so the game plays the
// same under every View. The engine finds the contacts; what to do about one is
// this game's rule.

use std
use engine

@derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)
Obstacle := struct {}

// Singleton: attach to one node to hold the run's score.
@derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)
Run := struct {
  crashes: int,
  last:    str,     // which obstacle ended the last run
}

obstacle_system := (run::Run) -> _ {
  hits := overlapping("PlayerControlled", "Obstacle")
  if (len(hits) == 0) { => _ }
  run.crashes := run.crashes + 1
  run.last := hits[0].other
  restart()
}
