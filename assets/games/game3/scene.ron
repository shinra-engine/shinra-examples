            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (0, 1),
                size: (0.8, 0.8),
            )),
            components: {
                "ScrollX": (speed: -0.4, wrap_at: -7.0, reset_to: 7.0),
            },
        ),
        (
            name: "bird",
            transform: (
                translation: (6.0, 2.1, -0.3),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
