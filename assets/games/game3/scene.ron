// Chrome-offline-style dino run. World data only: what exists, where it is,
// how big its collision box is, and which game components it carries.
//
// Behaviour lives in this folder's .hom systems:
//   player.hom    PlayerControlled — gravity + the "jump" action
//   scroller.hom  ScrollX          — slide along X, wrap around
//   obstacle.hom  Obstacle, Run    — collide with the player, restart
//
// Sprites are cut from assets/images/2x2_grid.png (2x2 grid):
//   (0,0) dino   (1,0) tree   (0,1) cloud   (1,1) bird
(
    name: "dino-run",
    camera: Some((
        eye: (0.0, 1.2, 10.0),
        target: (0.0, 1.2, 0.0),
        up: (0.0, 1.0, 0.0),
        projection: Orthographic(
            half_height: 2.6,
            aspect: 1.3333334,
            znear: 0.1,
            zfar: 50.0,
        ),
    )),
    nodes: [
        (
            name: "ground",
            transform: (
                translation: (0.0, -0.68, -0.5),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (16.0, 0.12, 1.0),
            ),
            mesh: Some((path: "assets/obj/quad_xy.obj")),
        ),
        (
            name: "dino",
            transform: (
                translation: (-3.0, 0.0, 0.2),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (0, 0),
                size: (1.2, 1.2),
            )),
            collider: Some((size: (0.84, 0.84))),
            components: {
                "PlayerControlled": (
                    gravity: -32.0,
                    jump_velocity: 10.5,
                    ground_y: 0.0,
                    vy: 0.0,
                ),
            },
        ),
        (
            name: "tree1",
            transform: (
                translation: (4.0, 0.05, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (1, 0),
                size: (1.3, 1.3),
            )),
            collider: Some((size: (0.91, 0.91))),
            components: {
                "Obstacle": (),
                "ScrollX": (speed: -3.0, wrap_at: -7.0, reset_to: 7.5),
            },
        ),
        (
            name: "tree2",
            transform: (
                translation: (9.5, 0.05, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (1, 0),
                size: (1.3, 1.3),
            )),
            collider: Some((size: (0.91, 0.91))),
            components: {
                "Obstacle": (),
                "ScrollX": (speed: -3.0, wrap_at: -7.0, reset_to: 7.5),
            },
        ),
        (
            name: "cloud1",
            transform: (
                translation: (1.0, 2.8, -1.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (0, 1),
                size: (1.0, 1.0),
            )),
            components: {
                "ScrollX": (speed: -0.6, wrap_at: -7.0, reset_to: 7.0),
            },
        ),
        (
            name: "cloud2",
            transform: (
                translation: (-3.5, 3.4, -1.0),
