// Scenery that slides along X and wraps around. Parallax comes from giving
// each layer a different speed in scene.ron.

use std
use engine

@derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)
ScrollX := struct {
  speed:    float,
  wrap_at:  float,
  reset_to: float,
}

scroll_system := (t::Transform, s: ScrollX, dt: float) -> _ {
  t.translation[0] := t.translation[0] + s.speed * dt

  past := (s.speed < 0.0 and t.translation[0] < s.wrap_at)
       or (s.speed > 0.0 and t.translation[0] > s.wrap_at)

  if (past) { t.translation[0] := s.reset_to }
}
