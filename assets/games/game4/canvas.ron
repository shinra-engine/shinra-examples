// A galgame screen: the stage, then the text box over it. The box is canvas
// nodes, not something the IDE draws.
(
    name: "terminal-hearts",
    nodes: [
        ( name: "viewport",
          rect: ( fill: true ),
          sprite: Some(( source: View("game") )) ),

        ( name: "box",
          rect: ( anchor: Bottom, size: Some((64, 4)), offset: (0, -1) ),
          color_rect: Some(( color: (0.05, 0.05, 0.12, 1.0) )),
          children: [
              ( name: "line",
                rect: ( anchor: TopLeft, size: Some((60, 1)), offset: (2, 1) ),
                text: Some(( from: Some("Dialogue.index"), format: "line {} — space advances" )) ),
          ] ),
    ],
)
