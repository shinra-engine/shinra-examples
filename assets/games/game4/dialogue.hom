// Visual-novel text flow: one line per "advance" action.
//
// The component carries the resource its text lives in, so scene.ron stays
// world data. Drawing the current line is the View's job, not a system's.

use std
use engine

@derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)
Dialogue := struct {
  script: str,
  index:  int,
  lines:  int,
}

dialogue_system := (d::Dialogue) -> _ {
  if (not action_pressed("advance")) { => _ }
  if (d.index + 1 >= d.lines) { => _ }
  d.index := d.index + 1
}
