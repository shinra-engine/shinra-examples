// A tiny visual-novel / galgame example.
// Start play mode with `r`, then press Space to advance each dialogue line.
(
    name: "terminal-hearts",
    camera: Some((
        eye: (0.0, 1.0, 10.0),
        target: (0.0, 1.0, 0.0),
        up: (0.0, 1.0, 0.0),
        projection: Orthographic(
            half_height: 3.2,
            aspect: 1.3333334,
            znear: 0.1,
            zfar: 50.0,
        ),
    )),
    nodes: [
        (
            name: "stage",
            transform: (
                translation: (0.0, 0.0, -1.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (12.0, 6.0, 1.0),
            ),
            mesh: Some((path: "assets/obj/quad_xy.obj")),
        ),
        (
            name: "mina",
            transform: (
                translation: (-2.1, 0.7, 0.2),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (0, 0),
                size: (2.5, 2.5),
            )),
        ),
        (
            name: "aster",
            transform: (
                translation: (2.1, 1.0, 0.1),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            sprite: Some((
                sheet: "assets/images/2x2_grid.png",
                grid: (2, 2),
                cell: (1, 1),
                size: (2.2, 2.2),
            )),
        ),
        (
            name: "story",
            components: [
                Dialogue(lines: [
                    (
                        speaker: "Narrator",
                        text: "The last train had gone, leaving only the glow of the terminal.",
                    ),
                    (
                        speaker: "Mina",
                        text: "You came. I was starting to think the rain had changed your mind.",
                    ),
                    (
                        speaker: "Aster",
                        text: "Not a chance. Some promises are worth getting soaked for.",
                    ),
                    (
                        speaker: "Mina",
                        text: "Then stay until the first train. I still have one story left to tell.",
                    ),
                    (
                        speaker: "Narrator",
                        text: "Pressing Space, they let the quiet night continue one line at a time.",
                    ),
                ]),
            ],
        ),
    ],
)
