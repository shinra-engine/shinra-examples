package shinra:game3@0.1.0;

interface components {
  use shinra:engine/types.{vec2, vec4};
  /// One drawable rectangle. `kind` says what it is (0 actor, 1 box, 2 glyph, 3 backdrop),
  /// `uv.x` carries the actor slot or the character code. ONE column because se-gpu draws one
  /// instance column per pipeline.
  record sprite { kind: u32, tint: vec4, pos: vec2, size: vec2, uv: vec4 }
}

interface pools {
  use components.{sprite};
  record sprites { s: sprite }
}

interface control {
  /// The reader's cursor. game.wasm is the ONLY writer (it also runs the typewriter).
  record line  { index: u32, revealed: u32, speaker: u32, done: u32, len: u32, elapsed: f32 }
  record stage { fade: f32, act: u32, cx: f32, cy: f32 }
  record view  { half-w: f32, half-h: f32, cx: f32, cy: f32 }
}

