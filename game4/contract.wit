// game4's contract: a 小蜜蜂 shooter. Nothing in it is 3D.
//
// One pool holds everything that moves or is drawn: the ship, its bullets, the
// bees, their bombs, the stars and one progress bar. A row is a `sprite` and an
// `actor`; `actor.kind` says which thing the row is, so a single stage moves
// all of them and a single instanced draw paints all of them.
package shinra:game4@0.1.0;

interface components {
  use shinra:engine/types.{vec2, vec4};

  /// One drawable rectangle, and the instance input of the only draw. `pos` is
  /// the centre, so collision is a centre-distance test against `size * 0.5`.
  /// `uv.x` carries the shape id the shader draws (ship, bullet, bee, bomb,
  /// star, bar); the rest of `uv` is unused.
  record sprite { pos: vec2, size: vec2, tint: vec4, uv: vec4 }

  /// What a row is and how it moves. `live == 0` is a parked row: it is not
  /// moved, not tested, and has a zero size so it draws nothing. Nothing is
  /// ever spawned or despawned, so the roster stays fixed — a bullet is a row
  /// that control hands out and the stage takes back.
  record actor { vel: vec2, kind: u32, live: u32 }
}

interface pools {
  use components.{sprite, actor};

  record sprites { s: sprite, a: actor }
}

interface control {
  /// The visible box, as half-extents around a centre.
  record view { half-w: f32, half-h: f32, cx: f32, cy: f32 }

  /// The run in progress. `alive` is 1 while playing, 0 once lost, 2 once won.
  /// `dir` is the swarm's heading (+1 right, -1 left), `bees` how many are
  /// left, and `rng` a seed advanced by control only.
  record run {
    alive: u32,
    score: u32,
    dir: f32,
    fire-t: f32,
    bomb-t: f32,
    rng: u32,
    bees: u32,
  }

}

